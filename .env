# macOS arm64 overrides for mujoco / free-mujoco-py
#
# GLFW: the glfw Python package (glfw 1.x) searches DYLD_LIBRARY_PATH on macOS.
# Homebrew installs GLFW to /opt/homebrew/lib on Apple Silicon.
DYLD_LIBRARY_PATH=/opt/homebrew/lib

# Compiler: free-mujoco-py's builder.py looks for GCC at hardcoded pre-arm64 paths
# (/usr/local/bin/gcc-{6..9}) and also passes -fopenmp which Apple Clang rejects.
# .venv/bin/gcc-mujoco is a wrapper that translates -fopenmp → Clang+libomp flags.
CC=.venv/bin/gcc-mujoco
